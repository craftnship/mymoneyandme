{
  "name": "mymoneyandme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "css": "tailwindcss -i src/styles/app.css -o src/app/globals.css",
    "dev": "concurrently -k -n css,next \"pnpm css --watch\" \"next dev\"",
    "build": "pnpm css --minify && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "mysql2": "3.15.3",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "nodemailer": "7.0.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "7.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.28.0"
}
