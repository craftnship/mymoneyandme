{
  "name": "mymoneyandme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "css": "tailwindcss -i src/styles/app.css -o src/app/globals.css",
    "dev": "concurrently -k -n css,next \"tailwindcss -i src/styles/app.css -o src/app/globals.css --watch\" \"next dev\"",
    "build": "tailwindcss -i src/styles/app.css -o src/app/globals.css --minify && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-tamil": "5.3.0",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.3",
    "mysql2": "3.24.6",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "nodemailer": "10.1.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.28.0"
}
