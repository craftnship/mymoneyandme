# Copy to .env.local for development. Production values are set on the host, never committed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Newsletter (optional in development; the form reports "not available" without these)
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/database
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=hello@mymoneyandme.in
# SMTP_PASS=
# NEWSLETTER_FROM=hello@mymoneyandme.in   # optional; defaults to SMTP_USER with the site name

# Member app (Phase 3). Accounts stay disabled until both DATABASE_URL and this key are set.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DATA_ENCRYPTION_KEY=
# CRON_SECRET=            # optional; protects GET /api/cron/purge
